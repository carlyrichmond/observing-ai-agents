        "w": 48,
        "h": 5
      },
      "config": {
        "content": "# GenAI Observability\n\nThis dashboard displays the usage of Large Language Models (LLM) and Vector Databases, tracking OpenTelemetry Traces and Metrics sent using [OpenLIT TypeScript SDK](https://docs.openlit.io/latest/sdk/overview) and the [AI SDK experimental telemetry flag](https://ai-sdk.dev/docs/ai-sdk-core/telemetry).\n\n",
        "settings": {
          "open_links_in_new_tab": true
        }
      }
    },
    {
      "id": "fc9f8451-fa92-46b2-a47a-94c45a7338aa",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 7
      },
      "config": {
        "type": "metric",
        "title": "Total Successful GenAI Requests",
        "query": {
          "language": "kql",
          "expression": "not (attributes.code.stacktrace : * )"
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "data_source": {
          "type": "data_view_reference",
          "ref_id": "apm_static_data_view_id_default"
        },
        "styling": {
          "density": "compact",
          "primary": {
            "position": "bottom",
            "labels": {
              "alignment": "left"
            },
            "value": {
              "alignment": "right",
              "sizing": "auto"
            }
          }
        },
        "metrics": [
          {
            "format": {
              "type": "number",
              "decimals": 0,
              "compact": false
            },
            "label": "Total Successful GenAI Requests",
            "empty_as_null": true,
            "operation": "count",
            "type": "primary",
            "color": {
              "type": "auto"
            }
          }
        ],
        "hide_title": true
      }
    },
    {
      "id": "4230457e-9ccc-4fcd-8ae6-5942d0e86360",
      "type": "vis",
      "grid": {
        "x": 10,
        "y": 5,
        "w": 11,
        "h": 7
      },
      "config": {
        "type": "metric",
        "title": "Total Successful GenAI Requests",
        "query": {
          "language": "kql",
          "expression": "span.type : \"db\" and db.response.status_code : \"200\" or db.response.status_code : \"201\""
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "data_source": {
          "type": "data_view_reference",
          "ref_id": "apm_static_data_view_id_default"
        },
        "styling": {
          "density": "compact",
          "primary": {
            "position": "bottom",
            "labels": {
              "alignment": "left"
            },
            "value": {
              "alignment": "right",
              "sizing": "auto"
            }
          }
        },
        "metrics": [
          {
            "format": {
              "type": "number",
              "decimals": 0,
              "compact": false
            },
            "label": "Total Successful VectorDB Requests",
            "field": "attributes.db.system",
            "empty_as_null": true,
            "operation": "count",
            "type": "primary",
            "color": {
              "type": "dynamic",
              "range": "absolute",
              "steps": [
                {
                  "lt": 34,
                  "color": "#16C5C0"
                },
                {
                  "gte": 34,
                  "color": "#16C5C0"
                }
              ]
            },
            "apply_color_to": "background"
          }
        ],
        "hide_title": true
      }
    },
