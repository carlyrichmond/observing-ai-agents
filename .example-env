# Azure OpenAI
AZURE_OPENAI_RESOURCE_NAME=my-deployment
OPENAI_ENDPOINT=https://my-deployment.openai.azure.com/openai/v1/
OPENAI_API_KEY=ARandomOpenAIKey?

# Weather API
WEATHER_API_KEY=MyWeatherKey!

# Elastic Ingestion
ELASTIC_ENDPOINT=https://my-elastic-deployment.es.com:443
ELASTIC_API_KEY=ARandomKey!

# OTel and OpenLit config
PROXY_ENDPOINT=http://localhost:8123
OTEL_EXPORTER_OTLP_ENDPOINT=https://my-elastic-otel-deployment:443
OTEL_EXPORTER_OTLP_ENDPOINT_API_KEY=AnotherRandomKey!

# OpenLIT server (required for LLM-as-a-judge evaluations)
# See README for one-time UI setup steps after first `docker compose up`.
OPENLIT_URL=http://localhost:3001
OPENLIT_API_KEY=openlit-ARandomOpenLitKey!
